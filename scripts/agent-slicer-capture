#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
container_name="${AGENT_SLICER_CONTAINER_NAME:-agent-slicer-orca}"
output_name="${1:-orca-$(date -u +%Y%m%dT%H%M%SZ).png}"

docker exec "${container_name}" \
    capture-orca "${output_name}"

echo "${repo_dir}/runtime/screenshots/${output_name}"
