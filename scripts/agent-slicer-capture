#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
output_name="${1:-orca-$(date -u +%Y%m%dT%H%M%SZ).png}"
export AGENT_SLICER_TOKEN="${AGENT_SLICER_TOKEN:-unused-for-compose-exec}"

docker compose \
    --project-directory "${repo_dir}" \
    -f "${repo_dir}/compose.yaml" \
    exec -T orcaslicer \
    capture-orca "${output_name}"

echo "${repo_dir}/runtime/screenshots/${output_name}"
