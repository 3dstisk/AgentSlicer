#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
mkdir -p \
    "${repo_dir}/runtime/config" \
    "${repo_dir}/runtime/screenshots" \
    "${repo_dir}/runtime/workspace"

docker compose \
    --project-directory "${repo_dir}" \
    -f "${repo_dir}/compose.yaml" \
    up -d

echo "AgentSlicer is starting at http://localhost:${ORCA_HTTP_PORT:-3000}"
