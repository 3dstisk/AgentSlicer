#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
container_name="${AGENT_SLICER_CONTAINER_NAME:-agent-slicer-orca}"
image="${AGENT_SLICER_IMAGE:-ghcr.io/3dstisk/agentslicer:latest}"

if [[ -z "${AGENT_SLICER_TOKEN:-}" ]]; then
    echo "AGENT_SLICER_TOKEN must be set to a non-empty secret" >&2
    exit 2
fi

puid="${PUID:-$(id -u)}"
pgid="${PGID:-$(id -g)}"
screen_width="${ORCA_SCREEN_WIDTH:-1920}"
screen_height="${ORCA_SCREEN_HEIGHT:-1080}"

mkdir -p \
    "${repo_dir}/runtime/config" \
    "${repo_dir}/runtime/outputs" \
    "${repo_dir}/runtime/screenshots" \
    "${repo_dir}/runtime/screenshots/mcp" \
    "${repo_dir}/runtime/workspace"

docker rm --force "${container_name}" >/dev/null 2>&1 || true
docker run --detach \
    --name "${container_name}" \
    --platform linux/amd64 \
    --env "PUID=${puid}" \
    --env "PGID=${pgid}" \
    --env "TZ=${TZ:-Europe/Prague}" \
    --env PIXELFLUX_WAYLAND=false \
    --env "SELKIES_MANUAL_WIDTH=${screen_width}" \
    --env "SELKIES_MANUAL_HEIGHT=${screen_height}" \
    --env "MAX_RES=${screen_width}x${screen_height}" \
    --env SELKIES_SCALING_DPI=96 \
    --env TITLE=AgentSlicer \
    --env LIBGL_ALWAYS_SOFTWARE=1 \
    --env GALLIUM_DRIVER=llvmpipe \
    --env DISABLE_ZINK=true \
    --env HARDEN_DESKTOP=true \
    --env START_DOCKER=false \
    --env SELKIES_FILE_TRANSFERS=none \
    --env SELKIES_COMMAND_ENABLED=false \
    --env SELKIES_ENABLE_SHARING=false \
    --env AGENT_SLICER_MCP_HOST=0.0.0.0 \
    --env AGENT_SLICER_MCP_PORT=8765 \
    --env AGENT_SLICER_TOKEN \
    --env "AGENT_SLICER_ALLOWED_HOSTS=${AGENT_SLICER_ALLOWED_HOSTS:-localhost,127.0.0.1,[::1]}" \
    --env "AGENT_SLICER_ALLOWED_ORIGINS=${AGENT_SLICER_ALLOWED_ORIGINS:-localhost,127.0.0.1,[::1]}" \
    --env AGENT_SLICER_BRIDGE_SOCKET=/run/agent-slicer/orca-agent.sock \
    --env "AGENT_SLICER_MAX_IMPORT_BYTES=${AGENT_SLICER_MAX_IMPORT_BYTES:-536870912}" \
    --env "AGENT_SLICER_MAX_UPLOAD_BYTES=${AGENT_SLICER_MAX_UPLOAD_BYTES:-536870912}" \
    --env "AGENT_SLICER_UPLOAD_TTL_MS=${AGENT_SLICER_UPLOAD_TTL_MS:-900000}" \
    --env AGENT_SLICER_SCREENSHOT_ROOTS=/screenshots/mcp \
    --env AGENT_SLICER_DESKTOP_SCREENSHOT_ROOT=/screenshots \
    --env AGENT_SLICER_CAPTURE_EXECUTABLE=/usr/local/bin/capture-orca \
    --volume "${repo_dir}/runtime/config:/config" \
    --volume "${repo_dir}/runtime/workspace:/workspace" \
    --volume "${repo_dir}/runtime/screenshots:/screenshots" \
    --volume "${repo_dir}/runtime/outputs:/outputs" \
    --publish "127.0.0.1:${ORCA_HTTP_PORT:-3000}:3000" \
    --publish "127.0.0.1:${ORCA_HTTPS_PORT:-3001}:3001" \
    --publish "127.0.0.1:${AGENT_SLICER_MCP_PORT:-8765}:8765" \
    --health-cmd 'curl --fail --silent --show-error http://127.0.0.1:8765/readyz' \
    --health-interval 10s \
    --health-timeout 7s \
    --health-start-period 120s \
    --health-retries 12 \
    --security-opt no-new-privileges:true \
    --shm-size 1gb \
    "${image}" >/dev/null

health_url="http://127.0.0.1:${AGENT_SLICER_MCP_PORT:-8765}/readyz"
deadline=$((SECONDS + ${AGENT_SLICER_START_TIMEOUT_SECONDS:-300}))
until curl --fail --silent --show-error "${health_url}" >/dev/null 2>&1; do
    if (( SECONDS >= deadline )); then
        echo "AgentSlicer did not become ready at ${health_url}" >&2
        docker logs --tail=200 "${container_name}" >&2
        exit 1
    fi
    sleep 2
done

echo "AgentSlicer GUI: http://localhost:${ORCA_HTTP_PORT:-3000}"
echo "AgentSlicer MCP: http://127.0.0.1:${AGENT_SLICER_MCP_PORT:-8765}/mcp"
