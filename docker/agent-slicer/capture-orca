#!/usr/bin/env bash
set -euo pipefail

stdout_mode="false"
if [[ "${1:-}" == "--stdout" ]]; then
    stdout_mode="true"
    shift
fi
output_name="${1:-orca-$(date -u +%Y%m%dT%H%M%SZ).png}"

if [[ "${output_name}" == */* || "${output_name}" != *.png ]]; then
    echo "Usage: capture-orca [--stdout] [filename.png]" >&2
    exit 2
fi

display=""
for _attempt in $(seq 1 60); do
    for candidate in "${DISPLAY:-}" :1 :0; do
        if [[ -n "${candidate}" ]] && xdpyinfo -display "${candidate}" >/dev/null 2>&1; then
            display="${candidate}"
            break 2
        fi
    done
    sleep 1
done

if [[ -z "${display}" ]]; then
    echo "No working X11 display found" >&2
    exit 1
fi

export DISPLAY="${display}"
screenshot_root="${AGENT_SLICER_SCREENSHOT_ROOT:-/screenshots}"
staging_root="${AGENT_SLICER_CAPTURE_STAGING_ROOT:-/run/agent-slicer/artifacts}"
output_path="${screenshot_root}/${output_name}"

if [[ ( "${stdout_mode}" != "true" && ( -L "${screenshot_root}" || ! -d "${screenshot_root}" ) ) ||
      -L "${staging_root}" || ! -d "${staging_root}" ]]; then
    echo "Screenshot and capture staging roots must be real directories" >&2
    exit 1
fi

umask 077
staging_dir="$(mktemp -d "${staging_root}/desktop-capture.XXXXXX")"
staging_cleanup_path="${staging_dir}/capture.png"
publication_dir=""
publication_cleanup_path=""
cleanup_staging() {
    rm -f -- "${staging_cleanup_path}"
    if [[ -n "${publication_cleanup_path}" ]]; then
        rm -f -- "${publication_cleanup_path}"
    fi
    if [[ -n "${publication_dir}" ]]; then
        rmdir -- "${publication_dir}" 2>/dev/null || true
    fi
    rmdir -- "${staging_dir}" 2>/dev/null || true
}
trap cleanup_staging EXIT
if (( BASH_VERSINFO[0] >= 4 )); then
    exec {staging_fd}<"${staging_dir}"
fi
if [[ -n "${staging_fd:-}" && -d "/proc/self/fd/${staging_fd}" ]]; then
    staging_path="/proc/self/fd/${staging_fd}/capture.png"
else
    # Non-Linux test/development fallback. Production capture runs in Linux.
    staging_path="${staging_cleanup_path}"
fi

window_found="false"
for _attempt in $(seq 1 60); do
    if xdotool search --onlyvisible --name 'OrcaSlicer|Orca Slicer' >/dev/null 2>&1; then
        window_found="true"
        break
    fi
    sleep 1
done

if [[ "${window_found}" != "true" ]]; then
    echo "No visible OrcaSlicer window found" >&2
    exit 1
fi

# Orca's frame appears well before its embedded HTML panels finish painting.
# Pay the longer delay only once per Orca process; later agent screenshots stay fast.
orca_pid="$(pgrep -f '/opt/orcaslicer/bin/orca-slicer' | head -n 1 || true)"
ready_marker="/tmp/agent-slicer-ready-pid"
ready_pid="$(cat "${ready_marker}" 2>/dev/null || true)"
if [[ -z "${orca_pid}" || "${ready_pid}" != "${orca_pid}" ]]; then
    sleep "${ORCA_INITIAL_CAPTURE_SETTLE_SECONDS:-10}"
    printf '%s\n' "${orca_pid}" > "${ready_marker}"
else
    sleep "${ORCA_CAPTURE_SETTLE_SECONDS:-1}"
fi

# Modal dialogs are separate X11 windows, so capture the complete desktop.
if [[ "${stdout_mode}" == "true" ]]; then
    import -display "${DISPLAY}" -window root png:-
    exit 0
fi

import -display "${DISPLAY}" -window root "${staging_path}"

test -s "${staging_path}"
publication_dir="$(mktemp -d "${screenshot_root}/.desktop-publication.XXXXXX")"
publication_cleanup_path="${publication_dir}/capture.png"
if (( BASH_VERSINFO[0] >= 4 )); then
    exec {publication_fd}<"${publication_dir}"
fi
if [[ -n "${publication_fd:-}" && -d "/proc/self/fd/${publication_fd}" ]]; then
    publication_path="/proc/self/fd/${publication_fd}/capture.png"
else
    publication_path="${publication_cleanup_path}"
fi
cp -- "${staging_path}" "${publication_path}"
test -s "${publication_path}"

# The final hard link is same-filesystem, atomic, and fails if a file or symlink
# already occupies the requested name.
ln -- "${publication_path}" "${output_path}"
echo "${output_path}"
